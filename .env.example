# The staff suite shares the member app's Supabase project — same URL, same keys.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required, not optional: member listing, moderation image signing and the staff
# audit log all go through the service-role client.
SUPABASE_SERVICE_ROLE_KEY=

VITE_HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Paddle — optional. The console refunds payments and cancels/switches
# subscriptions by calling Paddle directly, and /analytics reads gross revenue
# from Paddle's completed transactions. Same variable names as the member app so
# one set of secrets serves both. Without them the console still runs: revenue
# reports as unavailable and refunds are refused with the reason.
#
# PADDLE_ENV picks the environment *and* which key is used: sandbox (the default)
# reads PADDLE_SANDBOX_API_KEY, production reads PADDLE_API_KEY.
PADDLE_ENV=sandbox
PADDLE_SANDBOX_API_KEY=
PADDLE_API_KEY=

# Optional — error/crash reporting. Unset locally and in any deployment
# without a configured Sentry project; both sentry-client.ts and
# sentry.server.ts no-op when their respective DSN is empty (they now delegate
# to the facade in src/lib/observability/, which owns the no-op).
VITE_SENTRY_DSN=
SENTRY_DSN=
# Both DSNs are the same value (the Sentry project's DSN). VITE_SENTRY_DSN is
# baked into the browser bundle at build time; SENTRY_DSN is read by the server
# at runtime. Everything lives in src/lib/observability/. Session Replay is off
# in the staff suite. Before anything is sent, src/lib/observability/scrub.ts
# redacts emails, tokens, cookies, client IPs, images and every URL query value
# that is not a known-safe key (so Database searches never leave), and only the
# staff member's user id is attached. Known limit: a person's name written into
# free text (a console message, a database error echoing a value) cannot be
# recognised as a name and is sent as written.
# Also turn on "Prevent Storing of IP Addresses" in the Sentry project settings.
#
# Source maps (readable stack traces). Optional: without SENTRY_AUTH_TOKEN the
# build skips the upload and makes no network calls to Sentry. Build-time only.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
#
# Optional overrides. By default the environment is Vercel's VERCEL_ENV
# (production / preview / development) and the release is VERCEL_GIT_COMMIT_SHA.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Transactional email — needed by /announcements, which emails every member
# about a Mila update from Mila's noreply address. Delivery goes through
# Resend's HTTP API (src/lib/mailer.ts), so an API key is all that's required.
# Without it the screen still works and reports a dry run: it records what
# would have been sent and delivers nothing. MAIL_FROM must be a verified
# sender in Resend; it defaults to "Mila <noreply@mila.app>".
RESEND_API_KEY=
MAIL_FROM=
